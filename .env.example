# Bu dosyayı ".env" olarak kopyalayıp doldurun:  copy .env.example .env   (PowerShell)
# ".env" git'e eklenmez (.gitignore). Gerçek anahtarları ASLA bu dosyaya yazmayın.

# --- Zorunlu ---

# Yol kapama duyurularının bulunduğu sayfa (GÜZERGAH / TARİH / KAPANMA NEDENİ tablosu)
# Güncel adres (Ekim 2026): https://www.denizli.bel.tr/hizli-erisim/trafige-kapali-yollar
URL=https://www.denizli.bel.tr/hizli-erisim/trafige-kapali-yollar

# Google AI Studio / Gemini API anahtarı
GEMINI_API_KEY=

# Supabase (Dashboard -> Project Settings -> API)
SUPABASE_URL=
# service_role anahtarı RLS'i atlar: asla tarayıcıya/herkese açık yere sızmamalı.
SUPABASE_SERVICE_ROLE_KEY=

# Nuxt <-> Flask arası paylaşılan gizli anahtar (uzun, rastgele bir metin).
# Nuxt'un .env'indeki NUXT_INTERNAL_API_TOKEN ile AYNI olmalı.
INTERNAL_API_TOKEN=

# --- Önerilen ---

# Nominatim (OpenStreetMap) politikası, uygulamayı tanıtan bir User-Agent ister.
# İletişim e-postanızı veya sitenizi yazın. Boşsa program uyarı verir.
GEOCODER_CONTACT=

# --- İsteğe bağlı ---

# Gemini modeli (boşsa gemini-3.6-flash). Modeli değiştirmek için sadece bu
# satırı düzenleyin; API anahtarı aynı kalır. Geçerli model ID'leri:
#   https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=

# Kaynak siteye giden isteklerin User-Agent'ı (boşsa YolKapamaBot/1.0 ...)
SOURCE_USER_AGENT=

# Kendi Nominatim sunucunuz (boşsa genel https://nominatim.openstreetmap.org).
# Genel sunucuda saniyede en fazla 1 istek kuralı vardır; yoğun/sık çalıştırmada
# kendi sunucunuza geçmeniz önerilir.
NOMINATIM_URL=
# İstekler arası minimum bekleme (saniye). Genel sunucuda 1'in altına inmeyin.
NOMINATIM_MIN_INTERVAL=1.1

# Kendi OSRM sunucunuz (boşsa genel demo sunucu; üretim için önerilmez)
OSRM_URL=

# Geocoding önbelleği (aynı sorgular tekrar sunucuya gitmez)
# Satırı tamamen silerseniz varsayılan yol kullanılır; değeri boş bırakırsanız
# (GEOCODE_CACHE_PATH=) önbellek KAPANIR.
GEOCODE_CACHE_PATH=output/geocode_cache.sqlite
# Bulunan sonuçlar kaç gün saklansın / bulunamayan sorgular kaç gün hatırlansın
GEOCODE_CACHE_TTL_DAYS=30
GEOCODE_CACHE_NEGATIVE_TTL_DAYS=3

# Flask hata ayıklama (1 = açık). Yalnızca geliştirirken açın.
FLASK_DEBUG=
